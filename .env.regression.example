# Local full-stack defaults. Copy to .env.regression before deployment.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Use /api for the full-cloud-server mode. For GitHub Pages, set the public
# HTTPS API URL when building Pages, for example https://api.example.com/api.
VITE_API_BASE_URL=/api

# Include the GitHub Pages origin for the split deployment mode.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://why621.github.io
CORS_ALLOW_HEADERS=Accept,Content-Type
CORS_ALLOW_METHODS=GET,POST,OPTIONS

# Start conservatively on a small 2-core server and tune after measurement.
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
